# Compose Test 隔离参数；只有 Nginx 映射宿主机端口。
COMPOSE_PROJECT_NAME=unio_test
TEST_BIND_ADDRESS=127.0.0.1
NGINX_PUBLISHED_PORT=18080
APP_STOP_GRACE_PERIOD=75s

# Test PostgreSQL；DATABASE_URL 使用 Compose 服务名 postgres。
# POSTGRES_PASSWORD 与 DATABASE_URL 中的密码必须一致。
POSTGRES_DB=unio_test
POSTGRES_USER=unio_test
POSTGRES_PASSWORD=replace-with-test-db-password
DATABASE_URL=postgres://unio_test:replace-with-test-db-password@postgres:5432/unio_test?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m
POSTGRES_HEALTH_CHECK_PERIOD=5s

# Test Redis；地址使用 Compose 服务名 redis，仅 backend 网络可见。
REDIS_ADDR=redis:6379
REDIS_PASSWORD=replace-with-test-redis-password
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=10
REDIS_MAX_RETRIES=3
REDIS_MIN_RETRY_BACKOFF=8ms
REDIS_MAX_RETRY_BACKOFF=512ms
REDIS_KEY_NAMESPACE=unio:test

# 应用运行参数；容器内不读取仓库根目录的 .env。
UNIO_SKIP_DOTENV=true
GATEWAY_ENV=test
GATEWAY_HTTP_ADDR=:8520
ADMIN_HTTP_ADDR=:8521
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=60s
GATEWAY_MAX_JSON_BODY_MB=32
ADMIN_MAX_JSON_BODY_MB=4
GATEWAY_MAX_UPSTREAM_RESPONSE_MB=8

# Test console 写入容器 stdout；Gateway JSONL 写入 gateway_logs volume 并由 Alloy 采集。
LOG_LEVEL=info
LOG_FORMAT=json
GATEWAY_LOG_LEVEL=info
GATEWAY_CONSOLE_ENABLED=true
GATEWAY_LOG_FILE_PATH=/var/log/unio/gateway.jsonl
GATEWAY_LOG_MAX_SIZE_MB=25
GATEWAY_LOG_MAX_BACKUPS=5
GATEWAY_LOG_MAX_AGE_DAYS=7
LOKI_URL=http://loki:3100

# Admin 登录和 Gateway 内网诊断；GATEWAY_INTERNAL_TOKEN 由 Gateway/Admin 共用。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-test-admin-password
ADMIN_SESSION_TTL=12h
ADMIN_LOGIN_SOURCE_FAILURE_LIMIT=5
ADMIN_LOGIN_ACCOUNT_FAILURE_LIMIT=20
ADMIN_LOGIN_FAILURE_WINDOW=15m
GATEWAY_INTERNAL_TOKEN=replace-with-test-internal-token
GATEWAY_INTERNAL_URLS=http://gateway:8520
GATEWAY_INSTANCE_ID=gateway-test-1

# Gateway 请求处理。
PARTIAL_ASSUMED_CACHE_READ_RATIO=0.6
TOKEN_ESTIMATE_COUNT_MEDIA=true
TOKEN_ESTIMATE_FETCH_REMOTE_IMAGES=false
TOKEN_ESTIMATE_FETCH_TIMEOUT=3s
TOKEN_ESTIMATE_FETCH_MAX_MB=8

# Worker。
WORKER_STARTUP_TIMEOUT=10s
WORKER_RUNNER_IDLE_INTERVAL=1s
WORKER_SETTLEMENT_RECOVERY_LOCK_TTL=30s
WORKER_SETTLEMENT_RECOVERY_INITIAL_DELAY=30s
WORKER_SETTLEMENT_RECOVERY_SETTLE_TIMEOUT=10s
WORKER_SETTLEMENT_RECOVERY_MAX_ATTEMPTS=20
WORKER_SETTLEMENT_RECOVERY_BACKOFF_CAP=5m
WORKER_SETTLEMENT_RECOVERY_BATCH_SIZE=16
WORKER_ORPHAN_RESERVATION_SWEEP_AGE_THRESHOLD=15m
WORKER_ORPHAN_RESERVATION_SWEEP_BATCH_SIZE=100

# 外部目录同步和 tracing 默认关闭，按 Test 需要显式开启。
MODEL_CATALOG_SYNC_ENABLED=false
MODEL_CATALOG_SYNC_INTERVAL=24h
MODEL_CATALOG_SYNC_HTTP_TIMEOUT=30s
MODEL_CATALOG_SYNC_MAX_RESPONSE_BYTES=16777216
MODEL_CATALOG_SYNC_BASE_URL=https://models.dev
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=1
OTEL_SERVICE_NAME=unio-gateway-test
