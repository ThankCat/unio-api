# 四个发布镜像共用 tag；实际值放在同目录的 .env.docker。
GATEWAY_IMAGE_REPOSITORY=unio-gateway
ADMIN_IMAGE_REPOSITORY=unio-admin
WORKER_IMAGE_REPOSITORY=unio-worker
MIGRATION_IMAGE_REPOSITORY=unio-migration
IMAGE_TAG=replace-with-short-git-revision
IMAGE_VERSION=replace-with-release-version-or-short-revision
IMAGE_REVISION=replace-with-full-git-revision
IMAGE_CREATED=replace-with-rfc3339-build-time

# 构建和基础设施镜像版本，升级时逐项验证。
GO_BUILD_IMAGE=golang:1.26.5-alpine
APP_RUNTIME_IMAGE=alpine:3.22
MIGRATE_TOOL_IMAGE=migrate/migrate:v4.18.3
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
NGINX_IMAGE=nginx:1.29-alpine
LOKI_IMAGE=grafana/loki:3.5.3
ALLOY_IMAGE=grafana/alloy:v1.10.2

# 每个容器独立应用此 stdout/stderr 轮转上限。
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=5
