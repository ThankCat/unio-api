.env
.venv/

# 部署环境实际值不入库；只提交 .example 模板。
/deploy/env/.env.*
!/deploy/env/.env.*.example

# 本地测试库初始化配置（含真实 credential），不入库；示例见 scripts/test/test_db/config.local.example.json
scripts/test/test_db/config.local.json
.venv-*/
.idea/
.vscode/

# air 热加载构建产物与构建日志
tmp/
build-errors*.log
logs/

# go build ./cmd/<x> 在仓库根产生的可执行产物
/e2e-realtest

# delve 调试二进制（VS Code launch）
**/__debug_bin*
